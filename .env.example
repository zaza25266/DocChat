# OpenAI Settings (optional)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Custom API Settings (optional - e.g. Groq, OpenRouter, Together, Ollama)
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_API_URL=https://api.groq.com/openai/v1

# WatsonX Settings (optional)
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=skills-network
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Storage and Limits
MAX_FILE_SIZE=10485760
MAX_TOTAL_SIZE=52428800

CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=documents

VECTOR_SEARCH_K=10
LOG_LEVEL=INFO